# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID администратора для получения отчетов об ошибках (числом)
ADMIN_ID=123456789

# ID группы АмГУ по умолчанию (1671 = ИС231)
GROUP_ID=1671

# Название группы по умолчанию
GROUP_NAME=ИС231

# Часовой пояс (по умолчанию Asia/Yakutsk - Благовещенск UTC+9)
TIMEZONE=Asia/Yakutsk

# IP для Telegram API (обход сетевых блокировок хостинга/ТСПУ, оставьте пустым или 'off' для стандартного DNS)
TELEGRAM_API_IP=149.154.167.220

# Опорный понедельник начала семестра (для расчета четности недели)
SEMESTER_ANCHOR_MONDAY=2026-08-31

# Предварительное уведомление до начала пары (в минутах)
LESSON_REMINDER_MINUTES=15

# Путь к файлу базы данных SQLite (для Docker: data/bot_data.db)
DB_PATH=bot_data.db

# Время жизни кэша расписания в памяти (секунды)
CACHE_TTL_SECONDS=1800

# Таймауты подключения к API АмГУ (в секундах)
AMSU_CONNECT_TIMEOUT=1.5
AMSU_READ_TIMEOUT=3.0

# Принудительный оффлайн-режим (true = мгновенная работа только по SQLite/RAM без ожидания сети)
OFFLINE_MODE=false
